<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Union Oyster House — Est. 1826</title>
<meta name="description" content="Union Oyster House — America's oldest restaurant, on Boston's Freedom Trail since 1826.">
<style>
  @font-face{
    font-family:'Courier Prime';
    font-style:normal;
    font-weight:400;
    font-display:swap;
    src:url(data:font/woff2;base64,) format('woff2');
  }
  @font-face{
    font-family:'Courier Prime';
    font-style:normal;
    font-weight:700;
    font-display:swap;
    src:url(data:font/woff2;base64,) format('woff2');
  }
  @font-face{
    font-family:'Courier Prime';
    font-style:italic;
    font-weight:400;
    font-display:swap;
    src:url(data:font/woff2;base64,) format('woff2');
  }

  :root{
    --ink:#0B0B0A;
    --ink-soft:#19180F;
    --paper:#F7F3E9;
    --paper-dim:#EFE9D8;
    --stone:#E3DECC;
    --line-on-dark: rgba(247,243,233,0.2);
    --line-on-light: rgba(11,11,10,0.16);
    --buoy:#D6472C;
    --buoy-dark:#B53A22;
    --brass:#C6952C;
    --brass-dark:#A87A22;
    --harbor:#146B63;
    --harbor-dark:#0F5751;
    --text-on-dark:#F7F3E9;
    --text-on-dark-muted: rgba(247,243,233,0.66);
    --text-on-light:#141311;
    --text-on-light-muted: rgba(20,19,17,0.64);
    --font-mono:'Courier Prime', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --container:1180px;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  @media (prefers-reduced-motion: reduce){ html{scroll-behavior:auto;} }
  body{
    margin:0;
    background:var(--paper);
    color:var(--text-on-light);
    font-family:var(--font-mono);
    font-size:16px;
    line-height:1.7;
    -webkit-font-smoothing:antialiased;
    overflow-x:clip;
  }
  img,canvas,svg{display:block;max-width:100%;}
  a{color:inherit;}
  .wrap{max-width:var(--container); margin:0 auto; padding-inline:clamp(1.25rem,4vw,2.5rem);}

  h1,h2,h3,h4{
    font-family:var(--font-mono);
    font-weight:700;
    text-transform:uppercase;
    line-height:1.08;
    margin:0;
    text-wrap:balance;
    letter-spacing:0.01em;
  }
  p{margin:0;}
  .eyebrow{
    font-weight:700;
    font-size:0.72rem;
    letter-spacing:0.22em;
    text-transform:uppercase;
  }
  .lede{
    font-size:1.02rem;
    line-height:1.75;
    max-width:54ch;
  }
  .muted{ opacity:0.7; }

  button{font-family:inherit; cursor:pointer; color:inherit;}
  :focus-visible{outline:2px solid var(--buoy); outline-offset:3px;}

  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:0.6em;
    padding:0.95em 1.9em;
    font-weight:700; font-size:0.8rem;
    letter-spacing:0.16em;
    text-transform:uppercase;
    border:1.5px solid transparent;
    text-decoration:none;
    transition:transform 0.2s ease, background 0.2s ease, color .2s ease, border-color .2s ease;
    white-space:nowrap;
  }
  .btn:hover{ transform:translateY(-2px); }
  .btn-buoy{ background:var(--buoy); border-color:var(--buoy); color:#fff; }
  .btn-buoy:hover{ background:var(--buoy-dark); border-color:var(--buoy-dark); }
  .btn-brass{ background:var(--brass); border-color:var(--brass); color:var(--ink); }
  .btn-brass:hover{ background:var(--brass-dark); border-color:var(--brass-dark); }
  .btn-harbor{ background:var(--harbor); border-color:var(--harbor); color:#fff; }
  .btn-harbor:hover{ background:var(--harbor-dark); border-color:var(--harbor-dark); }
  .btn-outline-dark{ background:transparent; border-color:var(--line-on-dark); color:var(--text-on-dark); }
  .btn-outline-dark:hover{ border-color:var(--text-on-dark); }
  .btn-outline-light{ background:transparent; border-color:var(--line-on-light); color:var(--text-on-light); }
  .btn-outline-light:hover{ border-color:var(--text-on-light); }
  .btn-paper{ background:var(--paper); border-color:var(--paper); color:var(--ink); }
  .btn-paper:hover{ opacity:0.85; transform:translateY(-2px); }
  .btn-block{width:100%;}

  .sec-ink{ background:var(--ink); color:var(--text-on-dark); }
  .sec-paper{ background:var(--paper); color:var(--text-on-light); }
  .sec-stone{ background:var(--stone); color:var(--text-on-light); }

  /* ---------- NAV ---------- */
  header.site{
    position:fixed; inset:0 0 auto 0; z-index:50;
    padding:1.1rem 0;
    transition:background .3s ease, padding .3s ease;
    background:transparent;
    color:var(--text-on-dark);
  }
  header.site.solid{
    background:var(--ink);
    padding:0.7rem 0;
    border-bottom:1px solid var(--line-on-dark);
  }
  .nav-row{display:flex; align-items:center; justify-content:space-between; gap:1.5rem;}
  .brand{display:flex; align-items:center; gap:0.75rem; text-decoration:none; color:inherit;}
  .brand-mark{
    width:40px; height:40px; flex:none;
    border:1.5px solid currentColor;
    display:flex; align-items:center; justify-content:center;
    font-weight:700; font-size:0.78rem; letter-spacing:0.03em;
  }
  .brand-word{font-weight:700; font-size:0.95rem; letter-spacing:0.03em; text-transform:uppercase;}
  .brand-word small{display:block; font-weight:400; font-size:0.62rem; letter-spacing:0.14em; opacity:0.7; text-transform:uppercase;}
  nav.links{display:flex; align-items:center; gap:clamp(1rem,2vw,2rem);}
  nav.links a{font-size:0.76rem; font-weight:700; text-decoration:none; color:inherit; opacity:0.75; letter-spacing:0.12em; text-transform:uppercase; position:relative; padding:0.25rem 0;}
  nav.links a:hover{opacity:1;}
  nav.links a::after{content:"";position:absolute;left:0;right:100%;bottom:-2px;height:1px;background:var(--buoy);transition:right .25s ease;}
  nav.links a:hover::after{right:0;}
  .nav-cta{display:flex; align-items:center; gap:0.85rem;}
  .nav-cta .btn-outline-dark{font-size:0.72rem; padding:0.8em 1.3em;}
  .menu-toggle{display:none; background:none; border:1.5px solid currentColor; color:inherit; width:42px; height:42px; align-items:center; justify-content:center; flex:none;}

  @media (max-width:920px){
    nav.links{position:fixed; inset:0; background:var(--ink); color:var(--text-on-dark); flex-direction:column; justify-content:center; align-items:center; gap:1.75rem; transform:translateY(-100%); transition:transform .4s ease; padding-top:2rem;}
    nav.links.open{transform:translateY(0);}
    nav.links a{font-size:1.1rem;}
    .menu-toggle{display:flex;}
    .nav-cta .btn-outline-dark{display:none;}
  }
  @media (max-width:480px){
    .brand-word{font-size:0.78rem;}
    .brand-word small{font-size:0.55rem;}
    .nav-cta{gap:0.5rem;}
  }
  @media (max-width:380px){
    .brand-word{display:none;}
    .nav-cta .btn-buoy{padding:0.7em 0.9em; font-size:0.62rem; letter-spacing:0.06em;}
  }

  /* ---------- HERO GALLERY ---------- */
  .hero{
    position:relative;
    min-height:100svh;
    display:flex; align-items:flex-end;
    overflow:hidden;
    background:var(--ink);
    color:var(--text-on-dark);
  }
  .hero-gallery{ position:absolute; inset:0; }
  .hero-slide{ position:absolute; inset:0; opacity:0; transition:opacity 1.5s ease; }
  .hero-slide.active{ opacity:1; }
  .hero-slide[data-slide="0"]{ background:
      radial-gradient(120% 90% at 22% 8%, rgba(198,149,44,0.55) 0%, rgba(198,149,44,0) 42%),
      linear-gradient(155deg, #2b2109 0%, #14100a 55%, #0b0b0a 100%); }
  .hero-slide[data-slide="1"]{ background:
      repeating-radial-gradient(circle at 50% 40%, rgba(247,243,233,0.10) 0px, rgba(247,243,233,0.10) 2px, transparent 3px, transparent 14px),
      radial-gradient(100% 80% at 50% 20%, #23241f 0%, #0b0b0a 70%); }
  .hero-slide[data-slide="2"]{ background:
      repeating-linear-gradient(100deg, rgba(20,107,99,0.35) 0px, rgba(20,107,99,0.35) 3px, transparent 3px, transparent 22px),
      linear-gradient(200deg, #0d2422 0%, #0b0b0a 60%); }
  .hero-slide[data-slide="3"]{ background:
      repeating-linear-gradient(0deg, rgba(214,71,44,0.18) 0px, rgba(214,71,44,0.18) 18px, rgba(11,11,10,0) 18px, rgba(11,11,10,0) 40px),
      repeating-linear-gradient(90deg, rgba(247,243,233,0.05) 0px, rgba(247,243,233,0.05) 1px, transparent 1px, transparent 60px),
      linear-gradient(160deg, #241209 0%, #0b0b0a 65%); }
  .hero-slide[data-slide="4"]{ background:
      radial-gradient(90% 70% at 80% 90%, rgba(247,243,233,0.08) 0%, transparent 60%),
      repeating-linear-gradient(0deg, rgba(247,243,233,0.04) 0px, rgba(247,243,233,0.04) 1px, transparent 1px, transparent 34px),
      linear-gradient(170deg, #1a1a17 0%, #0b0b0a 70%); }
  .hero-scrim{
    position:absolute; inset:0; pointer-events:none;
    background:linear-gradient(180deg, rgba(11,11,10,0.1) 0%, rgba(11,11,10,0.45) 55%, rgba(11,11,10,0.94) 100%);
  }
  .hero-inner{position:relative; z-index:2; width:100%; padding-top:9rem; padding-bottom:clamp(6rem,11vw,8rem);}
  .hero-eyebrow{ color:var(--brass); }
  .hero-word{
    font-size:clamp(3rem,9.5vw,7rem);
    line-height:0.94;
    letter-spacing:0.01em;
    margin-top:0.75rem;
  }
  .hero-lede{ margin-top:1.5rem; color:var(--text-on-dark-muted); max-width:44ch; }
  .hero-inner .btn{ margin-top:2.25rem; }

  .hero-controls{
    position:absolute; z-index:3; left:0; right:0; bottom:clamp(1.5rem,4vw,2.25rem);
    display:flex; align-items:center; justify-content:center; gap:0.6rem;
  }
  .hero-dot{ width:8px; height:8px; border-radius:50%; background:rgba(247,243,233,0.32); border:none; padding:0; cursor:pointer; }
  .hero-dot.active{ background:var(--paper); }
  .hero-playpause{
    position:absolute; right:clamp(1.25rem,4vw,2.5rem); bottom:clamp(1.25rem,4vw,2rem);
    width:38px; height:38px; border-radius:50%; border:1px solid var(--line-on-dark);
    background:rgba(11,11,10,0.35); color:var(--text-on-dark);
    display:flex; align-items:center; justify-content:center; z-index:3;
  }

  .strip{ border-top:1px solid var(--line-on-dark); border-bottom:1px solid var(--line-on-dark); }
  .strip .wrap{display:flex; flex-wrap:wrap; gap:0.75rem 2.5rem; padding-block:1rem; justify-content:space-between;}
  .strip-item{display:flex; align-items:baseline; gap:0.55rem; font-size:0.78rem; letter-spacing:0.03em;}
  .strip-item b{font-weight:700;}

  /* ---------- SECTION shell ---------- */
  section{padding:clamp(4rem,9vw,7.5rem) 0; scroll-margin-top:5.5rem;}
  .section-head{display:flex; justify-content:space-between; align-items:flex-end; gap:2rem; margin-bottom:clamp(2.5rem,5vw,3.5rem); flex-wrap:wrap;}
  .section-head h2{font-size:clamp(1.8rem,3.6vw,2.5rem);}
  .reveal{opacity:0; transform:translateY(22px); transition:opacity .8s ease, transform .8s ease;}
  .reveal.in{opacity:1; transform:none;}
  @media (prefers-reduced-motion: reduce){ .reveal{opacity:1; transform:none; transition:none;} }

  /* ---------- INTRO (centered black text block) ---------- */
  .intro{ text-align:center; }
  .intro-inner{ max-width:62ch; margin:0 auto; }
  .intro-inner h2{ font-size:clamp(1.6rem,3.4vw,2.3rem); margin-top:0.85rem; }
  .intro-inner .lede{ margin:1.5rem auto 0; }

  /* ---------- SPLIT (image + copy, alternating) ---------- */
  .split{ padding:0; }
  .split-grid{ display:grid; grid-template-columns:1fr 1fr; min-height:560px; }
  @media (max-width:860px){ .split-grid{ grid-template-columns:1fr; min-height:0; } }
  .split-media{ position:relative; overflow:hidden; min-height:320px; }
  .split-media-inner{ position:absolute; inset:0; }
  .split-media--ledger{ background:
      repeating-linear-gradient(0deg, rgba(11,11,10,0.05) 0px, rgba(11,11,10,0.05) 1px, transparent 1px, transparent 32px),
      radial-gradient(120% 90% at 15% 10%, rgba(198,149,44,0.35), transparent 55%),
      linear-gradient(160deg, #D8CFAE 0%, #C7BB90 100%); }
  .split-media--brass{ background:
      repeating-radial-gradient(circle at 30% 30%, rgba(11,11,10,0.08) 0px, rgba(11,11,10,0.08) 2px, transparent 3px, transparent 16px),
      radial-gradient(100% 90% at 80% 20%, rgba(214,71,44,0.30), transparent 55%),
      linear-gradient(155deg, #E7C77A 0%, #C6952C 100%); }
  .split-copy{ display:flex; flex-direction:column; justify-content:center; padding:clamp(2.5rem,5vw,5rem); gap:1.25rem; }
  .split-copy .btn{ margin-top:0.75rem; align-self:flex-start; }

  /* ---------- HISTORY LEDGER (horizontal scroll on ink) ---------- */
  .ledger{ border-top:1px solid var(--line-on-dark); }
  .ledger-scroll{display:flex; gap:0; overflow-x:auto; scroll-snap-type:x proximity; padding-bottom:0.5rem; margin:0 calc(-1 * clamp(1.25rem,4vw,2.5rem)); padding-inline:clamp(1.25rem,4vw,2.5rem);}
  .ledger-scroll::-webkit-scrollbar{height:6px;}
  .ledger-scroll::-webkit-scrollbar-thumb{background:var(--line-on-dark);}
  .ledger-item{
    flex:0 0 auto; width:min(300px,78vw);
    scroll-snap-align:start;
    padding:1.75rem 1.75rem 1.75rem 0;
    border-right:1px solid var(--line-on-dark);
    margin-right:1.75rem;
  }
  .ledger-item:last-child{border-right:none;}
  .ledger-year{font-weight:700; font-size:1.7rem; color:var(--brass); letter-spacing:0.03em;}
  .ledger-item p{margin-top:0.65rem; opacity:0.68; font-size:0.92rem; text-transform:none; letter-spacing:normal; font-weight:400;}
  .ledger-item h4{font-size:0.95rem; margin-top:0.35rem; font-weight:700;}

  /* ---------- TOUT (full-bleed dimmed banner) ---------- */
  .tout{ position:relative; padding:0; min-height:60vh; display:flex; align-items:center; justify-content:center; overflow:hidden; text-align:center; }
  .tout-media{ position:absolute; inset:0;
    background:
      repeating-linear-gradient(115deg, rgba(20,107,99,0.4) 0px, rgba(20,107,99,0.4) 2px, transparent 2px, transparent 26px),
      radial-gradient(90% 70% at 50% 30%, rgba(198,149,44,0.25), transparent 60%),
      linear-gradient(180deg, #10201f 0%, #0b0b0a 80%);
  }
  .tout-scrim{ position:absolute; inset:0; background:rgba(11,11,10,0.35); }
  .tout-copy{ position:relative; z-index:2; padding:clamp(3.5rem,8vw,5rem) 1.5rem; }
  .tout-copy h2{ font-size:clamp(2rem,5vw,3.2rem); margin-top:0.75rem; }
  .tout-copy .btn{ margin-top:2rem; }

  /* ---------- RAW BAR BUILDER ---------- */
  .oyster-layout{display:grid; grid-template-columns:0.95fr 1.3fr; gap:clamp(2rem,5vw,4rem); align-items:start;}
  @media (max-width:900px){ .oyster-layout{grid-template-columns:1fr;} }
  .oyster-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:1px; background:var(--line-on-light); border:1px solid var(--line-on-light);}
  .oyster-card{
    background:var(--paper); padding:1.5rem; position:relative;
    display:flex; flex-direction:column; gap:0.75rem; min-height:190px;
  }
  .oyster-card svg{width:34px;height:22px;}
  .oyster-card h4{font-size:0.98rem;}
  .oyster-card .origin{font-size:0.7rem; letter-spacing:0.1em; text-transform:uppercase; color:var(--harbor); font-weight:700;}
  .oyster-card p{font-size:0.84rem; opacity:0.68; margin-top:auto; text-transform:none; letter-spacing:normal; font-weight:400;}
  .oyster-stepper{display:flex; align-items:center; gap:0.6rem; margin-top:0.4rem;}
  .oyster-stepper button{width:26px;height:26px; border:1.5px solid var(--line-on-light); background:transparent; color:inherit; font-size:1rem; line-height:1; font-weight:700;}
  .oyster-stepper button:hover{border-color:var(--buoy);}
  .oyster-stepper output{font-weight:700; min-width:1.4em; text-align:center; font-variant-numeric:tabular-nums;}

  .dozen-panel{
    background:var(--ink); color:var(--text-on-dark); padding:clamp(1.75rem,3vw,2.5rem);
    position:sticky; top:6.5rem;
  }
  .dozen-panel h3{font-size:1.2rem;}
  .dozen-panel .lede{font-size:0.9rem; margin-top:0.6rem; opacity:0.7;}
  .dozen-list{list-style:none; margin:1.5rem 0; padding:0; display:grid; gap:0.6rem;}
  .dozen-list li{display:flex; justify-content:space-between; font-size:0.88rem; opacity:0.82; font-variant-numeric:tabular-nums;}
  .dozen-total{display:flex; justify-content:space-between; align-items:baseline; border-top:1px solid var(--line-on-dark); padding-top:1rem; margin-top:0.5rem;}
  .dozen-total b{font-size:1.6rem; font-weight:700; font-variant-numeric:tabular-nums; color:var(--brass);}
  .dozen-empty{font-size:0.84rem; opacity:0.6; font-style:italic;}

  /* ---------- MENU ---------- */
  .menu-tabs{display:flex; gap:0.5rem; flex-wrap:wrap; border-bottom:1px solid var(--line-on-light); margin-bottom:2.25rem;}
  .menu-tab{
    background:none; border:none; padding:0.85rem 1.1rem; font-weight:700; font-size:0.78rem;
    letter-spacing:0.1em; text-transform:uppercase;
    opacity:0.55; border-bottom:2px solid transparent; margin-bottom:-1px;
    transition:opacity .2s ease, border-color .2s ease; font-family:var(--font-mono);
  }
  .menu-tab:hover{opacity:0.85;}
  .menu-tab[aria-selected="true"]{opacity:1; border-color:var(--buoy);}
  .menu-panel{display:none;}
  .menu-panel.active{display:block;}
  .menu-list{display:grid; grid-template-columns:1fr 1fr; gap:0 3rem;}
  @media (max-width:800px){ .menu-list{grid-template-columns:1fr;} }
  .menu-row{
    display:flex; justify-content:space-between; gap:1rem;
    padding:1.15rem 0; border-bottom:1px dashed var(--line-on-light);
  }
  .menu-row-name{font-weight:700; font-size:0.94rem; letter-spacing:0.02em;}
  .menu-row-desc{font-size:0.82rem; opacity:0.62; margin-top:0.3rem; max-width:34ch; text-transform:none; letter-spacing:normal;}
  .menu-row-price{font-weight:700; font-size:0.94rem; color:var(--buoy); white-space:nowrap; font-variant-numeric:tabular-nums;}
  .menu-note{margin-top:2rem; font-size:0.82rem; opacity:0.6; font-style:italic;}

  /* ---------- ROOMS ---------- */
  .rooms{display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line-on-light); border:1px solid var(--line-on-light); border-top:none;}
  @media (max-width:800px){ .rooms{grid-template-columns:1fr;} }
  .room{background:var(--stone); padding:2rem; display:flex; flex-direction:column; gap:0.6rem;}
  .room .cap{font-size:0.7rem; letter-spacing:0.12em; text-transform:uppercase; color:var(--harbor); font-weight:700;}
  .room h4{font-size:1.05rem;}
  .room p{font-size:0.86rem; opacity:0.65; text-transform:none; letter-spacing:normal; font-weight:400;}

  /* ---------- VISIT / RESERVE ---------- */
  .visit-grid{display:grid; grid-template-columns:1fr 1fr; gap:clamp(2rem,5vw,5rem); align-items:start;}
  @media (max-width:900px){ .visit-grid{grid-template-columns:1fr;} }
  .hours-table{width:100%; border-collapse:collapse; margin-top:1.5rem;}
  .hours-table td{padding:0.55rem 0; border-bottom:1px solid var(--line-on-dark); font-size:0.9rem;}
  .hours-table td:last-child{text-align:right; font-variant-numeric:tabular-nums; opacity:0.7;}
  .addr-block{margin-top:2rem; display:grid; gap:0.5rem; font-size:0.92rem;}
  .addr-block a{text-decoration:underline; text-decoration-color:var(--line-on-dark); text-underline-offset:3px;}
  .addr-block a:hover{text-decoration-color:var(--brass);}

  .res-form{display:grid; gap:1rem; background:var(--paper); color:var(--text-on-light); border:1.5px solid var(--ink); padding:clamp(1.75rem,3vw,2.5rem);}
  .res-row{display:grid; grid-template-columns:1fr 1fr; gap:1rem;}
  @media (max-width:520px){ .res-row{grid-template-columns:1fr;} }
  .field{display:grid; gap:0.4rem;}
  .field label{font-size:0.7rem; letter-spacing:0.1em; text-transform:uppercase; font-weight:700; opacity:0.65;}
  .field input, .field select{
    background:var(--paper-dim); border:1.5px solid var(--line-on-light); color:var(--text-on-light);
    padding:0.75em 0.85em; font-family:inherit; font-size:0.92rem;
  }
  .field input:focus, .field select:focus{border-color:var(--buoy); outline:none;}
  .res-confirm{display:none; border:1.5px solid var(--harbor); background:rgba(20,107,99,0.08); padding:1.5rem; margin-top:1rem; font-size:0.9rem;}
  .res-confirm.show{display:block;}
  .res-confirm b{color:var(--harbor);}

  footer.site{background:var(--ink); color:var(--text-on-dark); padding-top:clamp(3.5rem,7vw,5rem);}
  .foot-grid{display:grid; grid-template-columns:1.4fr 1fr 1fr 1fr; gap:2.5rem; padding-bottom:3rem; border-bottom:1px solid var(--line-on-dark);}
  @media (max-width:800px){ .foot-grid{grid-template-columns:1fr 1fr;} }
  @media (max-width:520px){ .foot-grid{grid-template-columns:1fr;} }
  .foot-grid h5{font-size:0.7rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--brass); font-weight:700; margin-bottom:1rem;}
  .foot-grid ul{list-style:none; margin:0; padding:0; display:grid; gap:0.6rem;}
  .foot-grid a{color:inherit; opacity:0.7; text-decoration:none; font-size:0.86rem;}
  .foot-grid a:hover{opacity:1;}
  .foot-bottom{display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap; padding:1.75rem 0; font-size:0.74rem; opacity:0.6;}

  .marquee-wrap{overflow:hidden; border-top:1px solid var(--line-on-light); border-bottom:1px solid var(--line-on-light); background:var(--stone);}
  .marquee{display:flex; gap:3rem; white-space:nowrap; padding:0.9rem 0; animation:scrollmq 32s linear infinite;}
  @media (prefers-reduced-motion: reduce){ .marquee{animation:none;} }
  .marquee span{font-style:italic; font-weight:700; font-size:0.85rem; letter-spacing:0.08em; text-transform:uppercase; display:flex; align-items:center; gap:3rem; opacity:0.7;}
  .marquee span::after{content:"—"; color:var(--buoy); opacity:1;}
  @keyframes scrollmq{ from{transform:translateX(0);} to{transform:translateX(-50%);} }
</style>
</head>
<body>
<header class="site" id="siteHeader">
  <div class="wrap nav-row">
    <a class="brand" href="#top">
      <span class="brand-mark" aria-hidden="true">UOH</span>
      <span class="brand-word">Union Oyster House<small>Boston · Est. 1826</small></span>
    </a>
    <nav class="links" id="navLinks">
      <a href="#history">History</a>
      <a href="#rawbar">Raw Bar</a>
      <a href="#menu">Menu</a>
      <a href="#events">Private Events</a>
      <a href="#visit">Visit</a>
    </nav>
    <div class="nav-cta">
      <a class="btn btn-outline-dark" href="tel:+16172272750">(617) 227-2750</a>
      <a class="btn btn-buoy" href="#visit">Reserve a Table</a>
      <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu" aria-expanded="false">
        <svg width="18" height="14" viewBox="0 0 18 14"><path d="M0 1h18M0 7h18M0 13h18" stroke="currentColor" stroke-width="1.6"/></svg>
      </button>
    </div>
  </div>
</header>

<main id="top">
  <section class="hero" aria-label="Introduction">
    <div class="hero-gallery" id="heroGallery" aria-hidden="true">
      <div class="hero-slide active" data-slide="0"></div>
      <div class="hero-slide" data-slide="1"></div>
      <div class="hero-slide" data-slide="2"></div>
      <div class="hero-slide" data-slide="3"></div>
      <div class="hero-slide" data-slide="4"></div>
    </div>
    <div class="hero-scrim"></div>
    <div class="hero-inner wrap">
      <p class="eyebrow hero-eyebrow">Welcome to</p>
      <h1 class="hero-word">Union<br>Oyster House</h1>
      <p class="lede hero-lede">America's oldest restaurant in continuous service — pouring oysters on the Freedom Trail, one block from Faneuil Hall, since 1826.</p>
      <a class="btn btn-buoy" href="#visit">Reserve a Table</a>
    </div>
    <div class="hero-controls" id="heroDots"></div>
    <button class="hero-playpause" id="heroPlayPause" aria-label="Pause gallery">
      <svg id="heroPlayPauseIcon" width="14" height="14" viewBox="0 0 14 14" fill="none"><rect x="2" y="1" width="3.4" height="12" fill="currentColor"/><rect x="8.6" y="1" width="3.4" height="12" fill="currentColor"/></svg>
    </button>
  </section>

  <div class="strip sec-ink">
    <div class="wrap">
      <div class="strip-item">🦪&nbsp;<b>America's Oldest Restaurant</b>&nbsp;— serving continuously since 1826</div>
      <div class="strip-item"><b>Freedom Trail</b>&nbsp;stop · one block from Faneuil Hall Marketplace</div>
      <div class="strip-item"><b>Sun–Thu</b>&nbsp;11am–9pm · <b>Fri–Sat</b>&nbsp;11am–10pm</div>
    </div>
  </div>

  <section class="sec-ink intro" aria-label="Welcome">
    <div class="wrap intro-inner reveal">
      <p class="eyebrow" style="color:var(--brass);">Est. 1826</p>
      <h2>Two centuries at the same oyster bar</h2>
      <p class="lede muted">Union Oyster House is America's oldest restaurant in continuous service, housed in a building that was already old when it opened. The oyster bar took its place at the front door in 1826 and has not moved an inch since — through fire, war, and two hundred years of Boston appetites.</p>
    </div>
  </section>

  <section class="split sec-stone" id="history" aria-label="History">
    <div class="split-grid">
      <div class="split-media reveal" aria-hidden="true">
        <div class="split-media-inner split-media--ledger"></div>
      </div>
      <div class="split-copy reveal">
        <p class="eyebrow" style="color:var(--harbor);">The Ledger</p>
        <h2>What the building has seen</h2>
        <p class="lede muted">Long before it was a restaurant, 41 Union Street was already keeping Boston's history — a dry-goods shop, a printing press, even a king in exile. Scroll the ledger below to see how a building becomes a landmark.</p>
      </div>
    </div>
  </section>

  <section class="ledger sec-ink" aria-label="Timeline">
    <div class="wrap">
      <div class="ledger-scroll reveal">
        <div class="ledger-item">
          <div class="ledger-year">1704</div>
          <h4>Hopestill Capen House</h4>
          <p>The brick building rises as a dry-goods shop selling silks and fabric — decades before it ever serves a meal.</p>
        </div>
        <div class="ledger-item">
          <div class="ledger-year">1771</div>
          <h4>A Press on the Second Floor</h4>
          <p>Isaiah Thomas prints the Massachusetts Spy upstairs, needling the Crown a few years before Lexington and Concord.</p>
        </div>
        <div class="ledger-item">
          <div class="ledger-year">1796</div>
          <h4>A King in Exile</h4>
          <p>Louis Philippe, future King of France, lodges above the building and is said to have given French lessons to Boston's daughters to pay his way.</p>
        </div>
        <div class="ledger-item">
          <div class="ledger-year">1826</div>
          <h4>The Oyster Bar Opens</h4>
          <p>Atwood &amp; Bacon open the Union Oyster House. The semicircular mahogany bar takes its place at the front door — and never moves again.</p>
        </div>
        <div class="ledger-item">
          <div class="ledger-year">1850s</div>
          <h4>Senator Webster's Stool</h4>
          <p>Daniel Webster becomes a regular, famously working through plates of oysters with a tall tumbler of brandy at his elbow.</p>
        </div>
        <div class="ledger-item">
          <div class="ledger-year">1960s</div>
          <h4>Booth 18</h4>
          <p>A young senator named John F. Kennedy claims a corner booth upstairs for the Sunday papers and a bowl of lobster stew.</p>
        </div>
        <div class="ledger-item">
          <div class="ledger-year">Today</div>
          <h4>Still Pouring</h4>
          <p>A National Historic Landmark, and still the oldest restaurant operating continuously in the United States.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="tout sec-ink" aria-label="Raw bar intro" style="padding:0;">
    <div class="tout-media" aria-hidden="true"></div>
    <div class="tout-scrim" aria-hidden="true"></div>
    <div class="tout-copy reveal">
      <p class="eyebrow" style="color:var(--brass);">The Raw Bar</p>
      <h2>Build your dozen</h2>
      <a class="btn btn-buoy" href="#rawbar">Start Shucking</a>
    </div>
  </section>

  <section id="rawbar" class="sec-paper" aria-label="Raw bar builder">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow" style="color:var(--buoy);">Five Varieties</p>
          <h2>Shucked to order</h2>
        </div>
        <p class="lede muted">Tap a shell to add it to your order — the same counter has shucked them since 1826.</p>
      </div>

      <div class="oyster-layout reveal">
        <div class="oyster-grid" id="oysterGrid">
          <!-- oyster cards injected by JS -->
        </div>

        <aside class="dozen-panel">
          <h3>Your Order</h3>
          <p class="lede">Half-shell selections, priced individually. Ready when you are.</p>
          <ul class="dozen-list" id="dozenList">
            <li class="dozen-empty">No oysters selected yet — start tapping.</li>
          </ul>
          <div class="dozen-total">
            <span>Subtotal</span>
            <b id="dozenTotal">$0</b>
          </div>
          <a class="btn btn-buoy btn-block" href="#visit" style="margin-top:1.5rem;">Reserve to Order This</a>
        </aside>
      </div>
    </div>
  </section>

  <div class="marquee-wrap" aria-hidden="true">
    <div class="marquee">
      <span>Wellfleet</span><span>Duxbury</span><span>Island Creek</span><span>Kumamoto</span><span>Malpeque</span>
      <span>Wellfleet</span><span>Duxbury</span><span>Island Creek</span><span>Kumamoto</span><span>Malpeque</span>
    </div>
  </div>

  <section id="menu" class="sec-paper" aria-label="Menu">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow" style="color:var(--buoy);">From the Kitchen</p>
          <h2>A taste of the table</h2>
        </div>
        <p class="lede muted">Four rooms, one kitchen. A sampling of what's on the boards this season — the full menu is at the host stand.</p>
      </div>

      <div class="reveal">
        <div class="menu-tabs" role="tablist" id="menuTabs"></div>
        <div id="menuPanels"></div>
        <p class="menu-note">Prices reflect a current seasonal sampling and are subject to change at the host stand.</p>
      </div>
    </div>
  </section>

  <section class="split sec-stone" id="events" aria-label="Private events" style="padding-top:0;padding-bottom:0;">
    <div class="split-grid">
      <div class="split-copy reveal">
        <p class="eyebrow" style="color:var(--harbor);">Meetings &amp; Functions</p>
        <h2>Three rooms, two centuries of walls</h2>
        <p class="lede muted">From a toast at the bar to a full second-floor buyout, our function coordinators set the table.</p>
        <a class="btn btn-harbor" href="mailto:events@unionoysterhouse.example">Book a Private Event</a>
      </div>
      <div class="split-media reveal" aria-hidden="true">
        <div class="split-media-inner split-media--brass"></div>
      </div>
    </div>
  </section>
  <div class="rooms reveal">
    <div class="room">
      <span class="cap">Seats up to 20</span>
      <h4>The Bar Room</h4>
      <p>The original 1826 oyster bar and stalls — Daniel Webster's corner, standing or seated.</p>
    </div>
    <div class="room">
      <span class="cap">Seats up to 45</span>
      <h4>The Sea Grill</h4>
      <p>Exposed brick and ship timber, ground floor, for private dinners and rehearsal suppers.</p>
    </div>
    <div class="room">
      <span class="cap">Seats up to 120</span>
      <h4>The Second Floor</h4>
      <p>Where Booth 18 sits — full buyouts for receptions, holiday parties, and corporate dinners.</p>
    </div>
  </div>

  <section class="sec-ink" id="visit" aria-label="Visit and reservations">
    <div class="wrap">
      <div class="visit-grid">
        <div class="reveal">
          <p class="eyebrow" style="color:var(--brass);">Visit</p>
          <h2 style="font-size:clamp(1.8rem,3.6vw,2.5rem);">On the Freedom Trail, one block from Faneuil Hall</h2>
          <table class="hours-table">
            <tr><td>Sunday – Thursday</td><td>11:00 AM – 9:00 PM</td></tr>
            <tr><td>Friday – Saturday</td><td>11:00 AM – 10:00 PM</td></tr>
            <tr><td>Raw Bar</td><td>Opens with the room</td></tr>
          </table>
          <div class="addr-block">
            <a href="https://maps.google.com/?q=41+Union+St,+Boston,+MA+02108" target="_blank" rel="noopener">41 Union Street, Boston, MA 02108 ↗</a>
            <a href="tel:+16172272750">(617) 227-2750</a>
            <a href="mailto:reservations@unionoysterhouse.example">reservations@unionoysterhouse.example</a>
          </div>
        </div>

        <form class="res-form reveal" id="resForm">
          <h3 style="font-size:1.2rem;">Request a Table</h3>
          <div class="res-row">
            <div class="field">
              <label for="resDate">Date</label>
              <input type="date" id="resDate" required>
            </div>
            <div class="field">
              <label for="resTime">Time</label>
              <input type="time" id="resTime" required>
            </div>
          </div>
          <div class="res-row">
            <div class="field">
              <label for="resParty">Party Size</label>
              <select id="resParty" required>
                <option value="">Select</option>
                <option>1</option><option>2</option><option>3</option><option>4</option>
                <option>5</option><option>6</option><option>7</option><option>8+</option>
              </select>
            </div>
            <div class="field">
              <label for="resName">Name</label>
              <input type="text" id="resName" placeholder="Full name" required>
            </div>
          </div>
          <div class="res-row">
            <div class="field">
              <label for="resPhone">Phone</label>
              <input type="tel" id="resPhone" placeholder="(617) 000-0000" required>
            </div>
            <div class="field">
              <label for="resEmail">Email</label>
              <input type="email" id="resEmail" placeholder="you@email.com" required>
            </div>
          </div>
          <button class="btn btn-buoy btn-block" type="submit">Request a Table</button>
          <div class="res-confirm" id="resConfirm">
            <b>Request received.</b> This preview form isn't connected yet — once live, we'll confirm your table by phone or email within a few hours.
          </div>
        </form>
      </div>
    </div>
  </section>
</main>

<footer class="site">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <span class="brand-word" style="font-size:1.05rem;">Union Oyster House</span>
        <p class="muted" style="font-size:0.86rem; margin-top:0.85rem; max-width:32ch; text-transform:none; letter-spacing:normal;">America's oldest restaurant, pouring oysters on the Freedom Trail since 1826.</p>
      </div>
      <div>
        <h5>Explore</h5>
        <ul>
          <li><a href="#history">History</a></li>
          <li><a href="#rawbar">Oysters</a></li>
          <li><a href="#menu">Menu</a></li>
          <li><a href="#events">Private Events</a></li>
        </ul>
      </div>
      <div>
        <h5>Visit</h5>
        <ul>
          <li><a href="#visit">Reservations</a></li>
          <li><a href="https://maps.google.com/?q=41+Union+St,+Boston,+MA+02108" target="_blank" rel="noopener">Directions</a></li>
          <li><a href="tel:+16172272750">(617) 227-2750</a></li>
        </ul>
      </div>
      <div>
        <h5>More</h5>
        <ul>
          <li><a href="#top">Gift Certificates</a></li>
          <li><a href="#top">Gift Shop</a></li>
          <li><a href="#top">Awards &amp; Honors</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© 1826–2026 Union Oyster House · 41 Union Street, Boston, MA</span>
      <span>Design concept · not the official site</span>
    </div>
  </div>
</footer>

<script>
(function(){
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Nav solid on scroll + mobile toggle
  var header = document.getElementById('siteHeader');
  var onScroll = function(){
    if(window.scrollY > 40){ header.classList.add('solid'); } else { header.classList.remove('solid'); }
  };
  document.addEventListener('scroll', onScroll, {passive:true});
  onScroll();

  var toggle = document.getElementById('menuToggle');
  var links = document.getElementById('navLinks');
  toggle.addEventListener('click', function(){
    var open = links.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open ? 'true':'false');
  });
  links.querySelectorAll('a').forEach(function(a){
    a.addEventListener('click', function(){ links.classList.remove('open'); toggle.setAttribute('aria-expanded','false'); });
  });

  // In-page anchor scrolling (explicit, so it accounts for the fixed header reliably)
  document.querySelectorAll('a[href^="#"]').forEach(function(a){
    a.addEventListener('click', function(e){
      var id = a.getAttribute('href').slice(1);
      var target = id ? document.getElementById(id) : null;
      if(!target) return;
      e.preventDefault();
      target.scrollIntoView({behavior: reduced ? 'auto':'smooth', block:'start'});
      history.pushState(null, '', '#'+id);
    });
  });

  // Reveal on scroll
  var revealEls = document.querySelectorAll('.reveal');
  if('IntersectionObserver' in window && !reduced){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    }, {threshold:0.12});
    revealEls.forEach(function(el){ io.observe(el); });
  } else {
    revealEls.forEach(function(el){ el.classList.add('in'); });
  }

  // Hero gallery: auto-advancing crossfade + dots + play/pause
  var slides = Array.prototype.slice.call(document.querySelectorAll('.hero-slide'));
  var dotsWrap = document.getElementById('heroDots');
  var current = 0, timer = null, playing = !reduced;
  var playBtn = document.getElementById('heroPlayPause');
  var playIcon = document.getElementById('heroPlayPauseIcon');

  slides.forEach(function(s, i){
    var dot = document.createElement('button');
    dot.className = 'hero-dot' + (i===0 ? ' active':'');
    dot.setAttribute('aria-label', 'Slide '+(i+1));
    dot.addEventListener('click', function(){ goTo(i); restart(); });
    dotsWrap.appendChild(dot);
  });
  var dots = Array.prototype.slice.call(dotsWrap.querySelectorAll('.hero-dot'));

  function goTo(i){
    slides[current].classList.remove('active');
    dots[current].classList.remove('active');
    current = i;
    slides[current].classList.add('active');
    dots[current].classList.add('active');
  }
  function next(){ goTo((current+1) % slides.length); }
  function start(){ if(timer) return; timer = setInterval(next, 4500); }
  function stop(){ clearInterval(timer); timer = null; }
  function restart(){ if(playing){ stop(); start(); } }
  function setIcon(){
    playIcon.innerHTML = playing
      ? '<rect x="2" y="1" width="3.4" height="12" fill="currentColor"/><rect x="8.6" y="1" width="3.4" height="12" fill="currentColor"/>'
      : '<path d="M2.5 1l9 6-9 6V1z" fill="currentColor"/>';
    playBtn.setAttribute('aria-label', playing ? 'Pause gallery' : 'Play gallery');
  }
  playBtn.addEventListener('click', function(){
    playing = !playing;
    if(playing){ start(); } else { stop(); }
    setIcon();
  });
  setIcon();
  if(playing) start();

  // Oyster raw bar builder
  var oysters = [
    {name:'Wellfleet', origin:'Wellfleet, MA', note:'Briny and clean, a cold snap off the flats.', price:2.75},
    {name:'Island Creek', origin:'Duxbury, MA', note:'Plump and briny-sweet — the Boston standard.', price:3.00},
    {name:'Duxbury', origin:'Duxbury, MA', note:'Mineral and crisp with a faint melon finish.', price:2.75},
    {name:'Kumamoto', origin:'Humboldt Bay, CA', note:'Small and sweet, a whisper of cucumber.', price:3.25},
    {name:'Malpeque', origin:'Prince Edward Island', note:'Firm and salty, the maritime classic.', price:2.75}
  ];
  var counts = oysters.map(function(){return 0;});
  var grid = document.getElementById('oysterGrid');
  var dozenList = document.getElementById('dozenList');
  var dozenTotal = document.getElementById('dozenTotal');

  function shellSvg(){
    return '<svg viewBox="0 0 40 26" fill="none"><path d="M2 20C2 10 12 3 20 3s18 7 18 17c0 3-8 4-18 4S2 23 2 20Z" stroke="var(--harbor)" stroke-width="1.3"/><path d="M6 19c4-2 8-3 14-3s10 1 14 3" stroke="var(--harbor)" stroke-width="0.8" opacity="0.5"/></svg>';
  }

  oysters.forEach(function(o, idx){
    var card = document.createElement('div');
    card.className = 'oyster-card';
    card.innerHTML =
      shellSvg() +
      '<div><h4>'+o.name+'</h4><span class="origin">'+o.origin+'</span></div>' +
      '<p>'+o.note+'</p>' +
      '<div class="oyster-stepper">'+
        '<button type="button" data-act="dec" aria-label="Remove one '+o.name+'">&minus;</button>'+
        '<output>0</output>'+
        '<button type="button" data-act="inc" aria-label="Add one '+o.name+'">+</button>'+
        '<span style="margin-left:auto; font-size:0.78rem; opacity:0.6; font-variant-numeric:tabular-nums;">$'+o.price.toFixed(2)+'</span>'+
      '</div>';
    grid.appendChild(card);
    var out = card.querySelector('output');
    card.querySelectorAll('button').forEach(function(btn){
      btn.addEventListener('click', function(){
        var delta = btn.dataset.act === 'inc' ? 1 : -1;
        counts[idx] = Math.max(0, Math.min(24, counts[idx]+delta));
        out.textContent = counts[idx];
        renderDozen();
      });
    });
  });

  function renderDozen(){
    var total = 0, any = false;
    dozenList.innerHTML = '';
    oysters.forEach(function(o, idx){
      if(counts[idx] > 0){
        any = true;
        var line = counts[idx] * o.price;
        total += line;
        var li = document.createElement('li');
        li.innerHTML = '<span>'+counts[idx]+'&times; '+o.name+'</span><span>$'+line.toFixed(2)+'</span>';
        dozenList.appendChild(li);
      }
    });
    if(!any){
      dozenList.innerHTML = '<li class="dozen-empty">No oysters selected yet — start tapping.</li>';
    }
    dozenTotal.textContent = '$'+total.toFixed(2);
  }

  // Menu tabs
  var menuData = {
    Lunch: [
      {name:'New England Clam Chowder', desc:'Cup or bowl, oyster crackers.', price:'9 / 12'},
      {name:'Maine Lobster Roll', desc:'Warm drawn butter or chilled mayo, split-top roll.', price:34},
      {name:'Fried Clam Plate', desc:'Whole-belly clams, tartar, coleslaw.', price:28},
      {name:'Union Burger', desc:'8oz, cheddar, fries.', price:19}
    ],
    Dinner: [
      {name:'Baked Stuffed Lobster', desc:'Cracker stuffing, drawn butter.', price:52},
      {name:'Broiled Scrod', desc:"Boston's own — lemon butter, breadcrumbs.", price:32},
      {name:'Oysters Rockefeller', desc:'Spinach, herb butter, pernod, half dozen.', price:19},
      {name:'Steamers', desc:'Soft-shell clams, broth, drawn butter.', price:24}
    ],
    Dessert: [
      {name:'Boston Cream Pie', desc:"The city's own invention.", price:10},
      {name:'Indian Pudding', desc:'Cornmeal and molasses, vanilla ice cream.', price:9},
      {name:'Warm Apple Crisp', desc:'Vanilla bean ice cream.', price:9},
      {name:'Key Lime Pie', desc:'Graham crust, whipped cream.', price:9}
    ],
    'Union Bar': [
      {name:'The 1826', desc:"Rye, brandy, demerara, bitters — Webster's order, reimagined.", price:16},
      {name:'Oyster Shooter', desc:'Chilled oyster, horseradish, vodka, cocktail sauce.', price:8},
      {name:"Dark 'n Stormy", desc:'Black rum, ginger beer, lime.', price:14},
      {name:'Boston Sour', desc:'Whiskey, lemon, egg white.', price:15}
    ]
  };
  var tabsEl = document.getElementById('menuTabs');
  var panelsEl = document.getElementById('menuPanels');
  var cats = Object.keys(menuData);
  cats.forEach(function(cat, i){
    var tab = document.createElement('button');
    tab.className = 'menu-tab';
    tab.textContent = cat;
    tab.setAttribute('role','tab');
    tab.setAttribute('aria-selected', i===0 ? 'true':'false');
    tab.addEventListener('click', function(){
      tabsEl.querySelectorAll('.menu-tab').forEach(function(t){ t.setAttribute('aria-selected','false'); });
      panelsEl.querySelectorAll('.menu-panel').forEach(function(p){ p.classList.remove('active'); });
      tab.setAttribute('aria-selected','true');
      document.getElementById('panel-'+i).classList.add('active');
    });
    tabsEl.appendChild(tab);

    var panel = document.createElement('div');
    panel.className = 'menu-panel' + (i===0 ? ' active':'');
    panel.id = 'panel-'+i;
    var list = document.createElement('div');
    list.className = 'menu-list';
    menuData[cat].forEach(function(item){
      var row = document.createElement('div');
      row.className = 'menu-row';
      row.innerHTML = '<div><div class="menu-row-name">'+item.name+'</div><div class="menu-row-desc">'+item.desc+'</div></div><div class="menu-row-price">$'+item.price+'</div>';
      list.appendChild(row);
    });
    panel.appendChild(list);
    panelsEl.appendChild(panel);
  });

  // Reservation mock submit
  var form = document.getElementById('resForm');
  var confirm = document.getElementById('resConfirm');
  form.addEventListener('submit', function(e){
    e.preventDefault();
    confirm.classList.add('show');
    confirm.scrollIntoView({behavior: reduced ? 'auto':'smooth', block:'nearest'});
  });
})();
</script>
</body>
</html>
